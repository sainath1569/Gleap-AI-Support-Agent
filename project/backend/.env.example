GROK_API_KEY=your_grok_api_key_here
GROK_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
QDRANT_URL=your_qdrant_cloud_url_here
QDRANT_API_KEY=your_qdrant_api_key_here

# CORS Configuration: Set to '*' to allow any origin (e.g. Vercel, localhost), or specify comma-separated URLs
CORS_ORIGINS=*

# Security & Authentication Configuration
ADMIN_API_KEY=gleap_admin_secret_key_123
ALLOW_UNAUTHENTICATED_ADMIN=true

# Rate Limiting & File Size Limits
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_UPLOAD=5/minute
MAX_UPLOAD_SIZE_MB=10

# MongoDB Conversation Persistence
MONGODB_URI=mongodb+srv://<db_username>:<password>@cluster0.dh4e7ab.mongodb.net/?appName=Cluster0
MONGODB_DATABASE=gleap_support
